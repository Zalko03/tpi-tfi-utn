{
    "version": 2,
    "headers": [
        {
            "source": "/(.*)",
            "headers": [
                {
                    "key": "X-Frame-Options",
                    "value": "DENY"
                },
                {
                    "key": "X-Content-Type-Options",
                    "value": "nosniff"
                },
                {
                    "key": "Referrer-Policy",
                    "value": "strict-origin-when-cross-origin"
                },
                {
                    "key": "Content-Security-Policy",
                    "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; frame-src https://www.openstreetmap.org; connect-src 'self' https://sapori-backend-django.onrender.com https://sapori-backend-node.onrender.com wss://sapori-backend-node.onrender.com http://localhost:8000 http://localhost:3000 ws://localhost:3000 http://127.0.0.1:8000 http://127.0.0.1:3000 ws://127.0.0.1:3000"
                }
            ]
        },
        {
            "source": "/(.*)sw\\.js",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=0, must-revalidate"
                },
                {
                    "key": "Service-Worker-Allowed",
                    "value": "/"
                }
            ]
        },
        {
            "source": "/(.*)manifest\\.webmanifest",
            "headers": [
                {
                    "key": "Content-Type",
                    "value": "application/manifest+json"
                }
            ]
        }
    ],
    "rewrites": [
        {
            "source": "/app/(.*)",
            "destination": "/web/$1"
        },
        {
            "source": "/css/(.*)",
            "destination": "/web/css/$1"
        },
        {
            "source": "/js/(.*)",
            "destination": "/web/js/$1"
        },
        {
            "source": "/sw.js",
            "destination": "/web/sw.js"
        },
        {
            "source": "/manifest.webmanifest",
            "destination": "/web/manifest.webmanifest"
        },
        {
            "source": "/",
            "destination": "/web/index.html"
        }
    ]
}
