# =============================================
# backend-django  (Django 5 + DRF + PostgreSQL)
# =============================================

DJANGO_SECRET_KEY=cambia-esto-por-una-clave-segura-de-50-caracteres
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Base de datos PostgreSQL
POSTGRES_DB=cafe_gestion
POSTGRES_USER=cafe_user
POSTGRES_PASSWORD=cambia-esto
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# JWT — RS256: solo Django emite tokens; Node valida con la clave pública.
# Para generar el par:
#   openssl genrsa -out backend-django/config/keys/private.pem 2048
#   openssl rsa -in backend-django/config/keys/private.pem -pubout -out backend-django/config/keys/public.pem
DJANGO_JWT_PRIVATE_KEY_PATH=config/keys/private.pem
DJANGO_JWT_PUBLIC_KEY_PATH=config/keys/public.pem
DJANGO_ACCESS_TOKEN_MINUTES=15
DJANGO_REFRESH_TOKEN_DAYS=1

# =============================================
# backend-node  (Express + Mongoose + Socket.IO)
# =============================================

NODE_ENV=development
NODE_PORT=3000

# Base de datos MongoDB
MONGO_URI=mongodb://localhost:27017/cafe_gestion

# JWT — Node solo valida; la clave pública la provee Django (RS256).
# Se puede indicar la ruta al archivo PEM o el contenido PEM directo en JWT_PUBLIC_KEY.
JWT_PUBLIC_KEY_PATH=config/keys/public.pem
# JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n..."

# URL interna del backend Django
DJANGO_BASE_URL=http://localhost:8000/api

# =============================================
# ai-service  (FastAPI + proveedor de IA — TP 3)
# =============================================

# Proveedor activo: 'ollama' (local) o 'gemini' (API externa — confirmar con docentes)
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434

# Solo si se usa Gemini API. La clave NUNCA va commiteada.
# GEMINI_API_KEY=

# =============================================
# Infra / Docker  (TP 4)
# =============================================

# COMPOSE_PROJECT_NAME=cafe-gestion
