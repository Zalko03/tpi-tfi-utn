# =============================================
# backend-django  (Django 5 + DRF + PostgreSQL)
# =============================================

DJANGO_SECRET_KEY=cambia-esto-por-una-clave-segura-de-50-caracteres
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Base de datos PostgreSQL
POSTGRES_DB=cafe_gestion
POSTGRES_USER=cafe_user
POSTGRES_PASSWORD=cambia-esto
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Base de datos alternativa SQLite (opcional: poner en True para tests aislados o desarrollo sin PostgreSQL)
# USE_SQLITE=False

# JWT — RS256: solo Django emite tokens; Node valida con la clave pública.
# Para generar el par:
#   openssl genrsa -out backend-django/config/keys/private.pem 2048
#   openssl rsa -in backend-django/config/keys/private.pem -pubout -out backend-django/config/keys/public.pem
DJANGO_JWT_PRIVATE_KEY_PATH=config/keys/private.pem
DJANGO_JWT_PUBLIC_KEY_PATH=config/keys/public.pem
# Alternativa: inyectar el contenido PEM directo en string (ej. en entornos CI sin archivos)
# DJANGO_JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n..."
# DJANGO_JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n..."
DJANGO_ACCESS_TOKEN_MINUTES=15
DJANGO_REFRESH_TOKEN_DAYS=1

# Seguridad y Endurecimiento (T2.5) — Configuración unificada de CORS (Django y Node) y Throttling
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000
DJANGO_THROTTLE_LOGIN=10/minute
DJANGO_THROTTLE_RECALCULAR=20/minute
DJANGO_THROTTLE_ANON=200/day
DJANGO_THROTTLE_USER=2000/day
DJANGO_LOG_LEVEL=INFO

# =============================================
# backend-node  (Express + Mongoose + Socket.IO)
# =============================================

NODE_ENV=development
NODE_PORT=3000

# Base de datos MongoDB
MONGO_URI=mongodb://localhost:27017/cafe_gestion

# JWT — Node solo valida; la clave pública la provee Django (RS256).
# Se puede indicar la ruta al archivo PEM o el contenido PEM directo en JWT_PUBLIC_KEY.
JWT_PUBLIC_KEY_PATH=config/keys/public.pem
# JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n..."

# URL interna del backend Django
DJANGO_BASE_URL=http://localhost:8000/api

# URL interna del servicio de IA (FastAPI)
AI_SERVICE_URL=http://localhost:8001

# CORS: Express consume CORS_ALLOWED_ORIGINS definido arriba (o CLIENT_ORIGIN como alias)
# CLIENT_ORIGIN=http://localhost:5173

# =============================================
# ai-service  (FastAPI + proveedor de IA — TP 3)
# =============================================

AI_SERVICE_PORT=8001

# Proveedor activo: 'gemini' (API externa recomendada para 8 GB RAM) u 'ollama' (local) — ADR-0002
AI_PROVIDER=gemini
AI_PROMPT_VERSION=v1
AI_TIMEOUT_SECONDS=10.0
AI_MAX_RETRIES=2

# Configuración Gemini API (la clave real NUNCA se versiona en Git)
GEMINI_API_KEY=cambia-esto-por-tu-gemini-api-key
GEMINI_MODEL=gemini-1.5-flash

# Configuración Ollama (opcional si AI_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b

# =============================================
# Infra / Docker  (TP 4)
# =============================================

# COMPOSE_PROJECT_NAME=cafe-gestion
