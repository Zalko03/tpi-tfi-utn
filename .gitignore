# ── Secretos ─────────────────────────────────────────────────────────────────
# Ignorar cualquier .env real; la excepción permite versionar solo el ejemplo.
.env
*.env
!.env.example

# ── Claves privadas ───────────────────────────────────────────────────────────
# El par JWT RS256 se genera localmente y NUNCA debe entrar al historial de Git.
# Documentado en .env.example: cómo generarlo con openssl.
*.pem
*.key
backend-django/config/keys/
backend-node/config/keys/

