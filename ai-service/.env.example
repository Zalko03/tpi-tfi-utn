# =============================================
# ai-service  (FastAPI + proveedor de IA — TP 3)
# =============================================

AI_SERVICE_PORT=8001

# Proveedor activo: 'groq' (LPU Cloud ultrarrápido sin consumo local), 'gemini' (API externa) u 'ollama' (local) — ADR-0002
AI_PROVIDER=groq
AI_PROMPT_VERSION=v1
AI_TIMEOUT_SECONDS=10.0
AI_MAX_RETRIES=2

# Configuración Groq LPU API (la clave real NUNCA se versiona en Git)
GROQ_API_KEY=cambia-esto-por-tu-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Configuración Gemini API (opcional si AI_PROVIDER=gemini)
GEMINI_API_KEY=cambia-esto-por-tu-gemini-api-key
GEMINI_MODEL=gemini-1.5-flash

# Configuración Ollama (opcional si AI_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b
